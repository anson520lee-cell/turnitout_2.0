# --- Supabase (Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret for the daily retention job (Vercel sends it as a Bearer token).
CRON_SECRET=
# Show "Continue with Google" (enable the Google provider in Supabase first).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# Preliminary analyzer implementation: heuristic (default)
WRITING_ANALYZER=heuristic
# Local development only: shows a "Simulate payment" button. Ignored in production builds.
ALLOW_DEV_PAYMENTS=false

# --- Free scans for visitors who aren't signed in ---
# Secret used to hash visitor IP addresses (the raw IP is never stored).
# Any long random string. If empty, one is derived from SUPABASE_SERVICE_ROLE_KEY.
GUEST_IP_SALT=
# Vercel is trusted automatically. On any other host, set this to true ONLY if
# your proxy overwrites X-Forwarded-For / X-Real-IP with the visitor's real
# address; otherwise all guests share one daily allowance.
TRUST_PROXY_IP_HEADERS=false

# --- Owner notifications (use either or both) ---
# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend (resend.com). NOTIFY_EMAIL_TO can be a comma-separated list.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# A message for every free scan, sent to Telegram only (never email, so scans
# can't use up the email quota payment alerts need). Set to false to stop them.
NOTIFY_ON_SCANS=true

# There is intentionally NO Turnitin setting. Turnitin credentials must never
# be stored in this application or its environment.
