# 複製這個檔案,改名為 .env,再填好下面四項。
# .env 只留在你的電腦上,不要上傳或傳給別人。

# 網站網址(最後不要加 /)
SITE_URL=https://your-site.vercel.app

# 和 Vercel 環境變數 MODEL_WORKER_SECRET 完全一樣的字串。
# 用「node worker.mjs --new-secret」產生一個,兩邊貼上同一個。
MODEL_WORKER_SECRET=

# Open WebUI 的網址:用 Docker 安裝通常是 http://localhost:3000,用 pip 安裝通常是 http://localhost:8080
OPENWEBUI_URL=http://localhost:3000

# Open WebUI > 左下角頭像 > 設定 > 帳號 > API 金鑰
OPENWEBUI_API_KEY=

# 模型名稱。跑「node worker.mjs --check」會列出你可以用的名稱。
OPENWEBUI_MODEL=

# ---- 以下可以不改 ----
# 有工作時每幾秒問一次網站;閒置 IDLE_AFTER_MINUTES 分鐘後改為每 IDLE_POLL_SECONDS 秒一次
POLL_SECONDS=4
IDLE_POLL_SECONDS=15
IDLE_AFTER_MINUTES=10
# 長文章分段交給模型,每段大約幾個字元(模型的 context 小就調低)
CHUNK_CHARS=4000
# 單次模型回覆最多等幾分鐘
MODEL_TIMEOUT_MINUTES=15
TEMPERATURE=0.3
# 不經 Open WebUI、直接連 Ollama 時用:
#   OPENWEBUI_URL=http://localhost:11434
#   CHAT_PATH=/v1/chat/completions
#   MODELS_PATH=/v1/models
